{
  "name": "omo-gws-multi-account",
  "version": "0.4.0",
  "description": "Multi-account management for the Google Workspace CLI (`gws`). omo package: a `tool_call` hook and a bundled skill.",
  "keywords": [
    "google-workspace",
    "gws",
    "hooks",
    "multi-account",
    "omo",
    "pi-package"
  ],
  "homepage": "https://github.com/indentcorp/gws-multi-account",
  "license": "MIT",
  "author": "Jeon Suyeol",
  "repository": {
    "type": "git",
    "url": "https://github.com/indentcorp/gws-multi-account.git",
    "directory": "packages/omo"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "prepublishOnly": "cd ../.. && bun run build"
  },
  "devDependencies": {
    "@gws-multi-account/core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=18"
  }
}
